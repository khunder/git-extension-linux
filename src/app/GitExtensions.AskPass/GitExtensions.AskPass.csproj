<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tiny console helper that git/ssh invoke as GIT_ASKPASS / SSH_ASKPASS. It forwards the prompt (argv[1]) to the running
    Git Extensions window over a private local channel and prints the answer to stdout. BCL only, no WinForms.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>GitExtensions.AskPass</RootNamespace>
    <AssemblyName>GitExtensions.AskPass</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

</Project>
