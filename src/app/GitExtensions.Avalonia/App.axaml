<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitExtensions.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- The size of the monospaced text of the diff, blame, file and patch views; Ctrl +/- and Ctrl+wheel change it. -->
      <x:Double x:Key="EditorFontSize">12</x:Double>
      <x:Double x:Key="HistoryFontSize">12</x:Double>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GitExtensions.Avalonia/Styles/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- Tooltips are always light grey with dark text, like the original, whatever the theme. -->
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="#F4F4F4" />
      <Setter Property="Foreground" Value="#1E1E1E" />
      <Setter Property="BorderBrush" Value="#B8B8B8" />
    </Style>
    <!-- The Git Extensions logo is the icon of every window. -->
    <Style Selector="Window">
      <Setter Property="Icon" Value="avares://GitExtensions.Avalonia/Assets/AppIcon/git-extensions.png" />
    </Style>
  </Application.Styles>
</Application>
