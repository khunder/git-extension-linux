<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitExtensions.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GitExtensions.Avalonia/Styles/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- The Git Extensions logo is the icon of every window. -->
    <Style Selector="Window">
      <Setter Property="Icon" Value="avares://GitExtensions.Avalonia/Assets/AppIcon/git-extensions.png" />
    </Style>
  </Application.Styles>
</Application>
