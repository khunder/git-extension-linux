<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.LostObjectsView"
             x:DataType="vm:LostObjectsViewModel">
  <DockPanel Margin="16" AutomationProperties.Name="Verify database">
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <Button x:Name="ScanButton" Content="Scan" Command="{Binding ScanCommand}" Margin="0,0,8,4" />
      <CheckBox x:Name="UnreachableCheck" Content="Unreachable" IsChecked="{Binding Unreachable}" Margin="0,0,8,4" ToolTip.Tip="--unreachable: also list objects only other lost objects point to" />
      <CheckBox x:Name="FullCheck" Content="Full check" IsChecked="{Binding FullCheck}" Margin="0,0,8,4" ToolTip.Tip="--full: also look into alternates and packs" />
      <CheckBox x:Name="NoReflogsCheck" Content="No reflogs" IsChecked="{Binding NoReflogs}" Margin="0,0,16,4" ToolTip.Tip="--no-reflogs: do not treat reflog entries as reachable" />
      <CheckBox x:Name="ShowCommitsCheck" Content="Commits and tags" IsChecked="{Binding ShowCommitsAndTags}" Margin="0,0,8,4" />
      <CheckBox x:Name="ShowOthersCheck" Content="Other objects" IsChecked="{Binding ShowOtherObjects}" Margin="0,0,8,4" />
    </WrapPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="RestoreTagsButton" Content="Restore ticked as tags" Command="{Binding RestoreCheckedAsTagsCommand}" ToolTip.Tip="Creates LOST_FOUND_&lt;id&gt; tags" />
        <Button x:Name="BranchButton" Content="Create branch…" Command="{Binding RequestCreateBranchCommand}" IsEnabled="{Binding CanRestore}" />
        <Button x:Name="TagButton" Content="Create tag…" Command="{Binding RequestCreateTagCommand}" IsEnabled="{Binding CanRestore}" />
        <Button x:Name="DeleteTagsButton" Content="Delete LOST_FOUND tags…" Command="{Binding RequestDeleteTagsCommand}" />
        <Button x:Name="PruneButton" Content="Prune…" Command="{Binding RequestPruneCommand}" ToolTip.Tip="git prune: delete the dangling objects for good" />
      </StackPanel>
    </Grid>

    <Panel x:Name="PromptPanel" DockPanel.Dock="Top" IsVisible="{Binding IsPromptVisible}" Margin="0,0,0,6">
      <Border Background="{DynamicResource SystemAccentColor}" Opacity="0.15" />
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="8,6">
        <StackPanel Spacing="4">
          <TextBlock x:Name="PromptTextBlock" Text="{Binding PromptText}" TextWrapping="Wrap" />
          <TextBox x:Name="PromptNameBox" Text="{Binding PromptName}" IsVisible="{Binding NeedsInput}">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ConfirmPromptCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding CancelPromptCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </StackPanel>
        <Button x:Name="PromptConfirm" Grid.Column="1" Content="{Binding ConfirmText}" Command="{Binding ConfirmPromptCommand}" VerticalAlignment="Top" />
        <Button x:Name="PromptCancel" Grid.Column="2" Content="Cancel" Command="{Binding CancelPromptCommand}" VerticalAlignment="Top" />
      </Grid>
    </Panel>

    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
      <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText}" Opacity="0.75" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button x:Name="CloseButton" Grid.Column="1" Content="Close" Command="{Binding CloseCommand}" />
    </Grid>
    <ProgressBar DockPanel.Dock="Bottom" Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

    <Grid RowDefinitions="*,6,140">
      <ListBox x:Name="LostList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LostObjectItem">
            <Grid ColumnDefinitions="Auto,90,150,80,*,130" ColumnSpacing="8">
              <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsCommitLike}" MinWidth="24" />
              <TextBlock Grid.Column="1" Text="{Binding RawType}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.8" />
              <TextBlock Grid.Column="2" Text="{Binding DateText}" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding ShortHash}" Classes="mono" VerticalAlignment="Center" />
              <TextBlock Grid.Column="4" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <TextBlock Grid.Column="5" Text="{Binding Author}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Opacity="0.8" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Row="1" Background="Transparent" HorizontalAlignment="Stretch" />
      <TextBox x:Name="PreviewBox" Grid.Row="2" Text="{Binding Preview}" IsReadOnly="True" AcceptsReturn="True" Classes="mono" AutomationProperties.Name="Preview of the selected object" />
    </Grid>
  </DockPanel>
</UserControl>
