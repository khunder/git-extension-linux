<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.ShortcutsHelpView"
             x:DataType="vm:ShortcutsHelpViewModel"
             Focusable="True"
             AutomationProperties.Name="Keyboard shortcuts">
  <UserControl.Styles>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
    </Style>
  </UserControl.Styles>
  <DockPanel x:Name="Card" Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="CloseButton" Content="Close" IsDefault="True" MinWidth="80" HorizontalContentAlignment="Center" Command="{Binding CloseCommand}" ToolTip.Tip="Close (Esc)" />
    </StackPanel>
    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="GroupList" ItemsSource="{Binding Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ShortcutGroup">
            <StackPanel Margin="0,0,0,10" Spacing="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Opacity="0.85" Margin="0,0,0,2" />
              <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShortcutEntry">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="8,1,12,1">
                      <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Gesture}" Classes="mono" Opacity="0.7" FontSize="12" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
