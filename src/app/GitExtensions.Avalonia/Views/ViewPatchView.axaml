<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             xmlns:diff="using:GitExtensions.Desktop.Diff"
             xmlns:views="using:GitExtensions.Desktop.Views"
             x:Class="GitExtensions.Desktop.Views.ViewPatchView"
             x:DataType="vm:ViewPatchViewModel">
  <UserControl.Styles>
    <Style Selector="Border.added"><Setter Property="Background" Value="{DynamicResource DiffAddedBackground}" /></Style>
    <Style Selector="Border.removed"><Setter Property="Background" Value="{DynamicResource DiffRemovedBackground}" /></Style>
    <Style Selector="Border.hunk"><Setter Property="Background" Value="{DynamicResource DiffHunkBackground}" /></Style>
  </UserControl.Styles>
  <Panel Background="{DynamicResource ScrimBrush}">
    <Border x:Name="Card" MaxWidth="1000" Margin="24" Padding="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource DialogBackground}"
            BorderBrush="{DynamicResource SubtleBorderBrush}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="View patch file" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <TextBox x:Name="PathBox" Text="{Binding FilePath}" Watermark="Path of a .patch or .diff file">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding LoadTypedCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" />
          <Button x:Name="CloseButton" Grid.Column="2" Content="Close" Command="{Binding CloseCommand}" />
        </Grid>
        <TextBlock x:Name="ErrorText" DockPanel.Dock="Top" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                   Foreground="{DynamicResource ErrorTextForeground}" Margin="0,6,0,0" />
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" Text="{Binding Summary}" Opacity="0.7" Margin="0,6,0,6" />
        <Border BorderThickness="1" BorderBrush="{DynamicResource SubtleBorderBrush}">
          <ItemsControl x:Name="PatchLines" ItemsSource="{Binding Lines}">
            <ItemsControl.Template>
              <ControlTemplate>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="diff:DiffLine">
                <Border Classes.added="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static diff:DiffLineKind.Added}}"
                        Classes.removed="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static diff:DiffLineKind.Removed}}"
                        Classes.hunk="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static diff:DiffLineKind.Hunk}}">
                  <Grid ColumnDefinitions="44,44,*" Opacity="{Binding Kind, Converter={x:Static views:DiffLineBrushes.TextOpacity}}">
                    <TextBlock Text="{Binding OldNumber}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="12" Opacity="0.5" TextAlignment="Right" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="1" Text="{Binding NewNumber}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="12" Opacity="0.5" TextAlignment="Right" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="2" Text="{Binding DisplayText}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="12" TextWrapping="NoWrap" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
