<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.PushView"
             x:DataType="vm:PushDialogViewModel">
  <Border x:Name="Card" Padding="16">
    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
        <Button x:Name="CancelRunButton" Content="Stop" Command="{Binding CancelCommand}" IsVisible="{Binding IsRunning}" />
        <Button x:Name="PushButton" Content="Push" Classes="accent" IsDefault="True" MinWidth="110" Command="{Binding PushCommand}" />
        <Button x:Name="CloseButton" Content="Close" Command="{Binding CloseCommand}" />
      </StackPanel>
      <ProgressBar DockPanel.Dock="Bottom" Height="3" IsIndeterminate="True" IsVisible="{Binding IsRunning}" Margin="0,8,0,0" />
      <TextBox x:Name="OutputBox" DockPanel.Dock="Bottom" Text="{Binding OutputText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
               Height="110" Classes="mono" Margin="0,10,0,0" Watermark="What git says appears here" AutomationProperties.Name="Push output" />
      <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                 Foreground="{DynamicResource ErrorTextForeground}" Margin="0,8,0,0" />

      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10">
          <Border BorderThickness="1" BorderBrush="{DynamicResource SubtleBorderBrush}" CornerRadius="4" Padding="10">
            <StackPanel Spacing="6">
              <TextBlock Text="Push to" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                <RadioButton x:Name="RemoteRadio" GroupName="PushTarget" Content="_Remote" IsChecked="{Binding UsesRemote, Mode=OneWay}" VerticalAlignment="Center" />
                <ComboBox x:Name="RemoteCombo" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Remotes}" SelectedItem="{Binding SelectedRemote}"
                          IsEnabled="{Binding UsesRemote}" AutomationProperties.Name="Remote" />
                <RadioButton x:Name="UrlRadio" Grid.Row="1" GroupName="PushTarget" Content="U_rl" IsChecked="{Binding UseUrl}" VerticalAlignment="Center" />
                <TextBox x:Name="UrlBox" Grid.Row="1" Grid.Column="1" Text="{Binding Url}" IsEnabled="{Binding UseUrl}" Watermark="https://host/owner/repo.git or a folder" AutomationProperties.Name="URL" />
              </Grid>
            </StackPanel>
          </Border>

          <Border BorderThickness="1" BorderBrush="{DynamicResource SubtleBorderBrush}" CornerRadius="4" Padding="10">
            <StackPanel Spacing="6">
              <TextBlock Text="Branch" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6" IsEnabled="{Binding CanChooseBranch}">
                <TextBlock Text="Branch to push" VerticalAlignment="Center" />
                <ComboBox x:Name="LocalBranchCombo" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LocalBranches}" SelectedItem="{Binding LocalBranch}"
                          AutomationProperties.Name="Branch to push" />
                <TextBlock Grid.Row="1" Text="to" VerticalAlignment="Center" />
                <ComboBox x:Name="RemoteBranchCombo" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" IsEditable="True"
                          ItemsSource="{Binding RemoteBranches}" Text="{Binding RemoteBranch}" AutomationProperties.Name="Remote branch" />
              </Grid>
              <CheckBox x:Name="SetUpstreamBox" Content="Set the branch as upstream (track the remote branch)" IsChecked="{Binding SetUpstream}" IsEnabled="{Binding CanChooseBranch}" />
              <CheckBox x:Name="AllBranchesBox" Content="Push all branches" IsChecked="{Binding PushAllBranches}" IsEnabled="{Binding !PushAllTags}" />
              <CheckBox x:Name="AllTagsBox" Content="Push all tags" IsChecked="{Binding PushAllTags}" IsEnabled="{Binding !PushAllBranches}" />
            </StackPanel>
          </Border>

          <Border BorderThickness="1" BorderBrush="{DynamicResource SubtleBorderBrush}" CornerRadius="4" Padding="10">
            <StackPanel Spacing="4">
              <TextBlock Text="Force" FontWeight="SemiBold" />
              <CheckBox x:Name="ForceWithLeaseBox" Content="_Force with lease (refuses when somebody else pushed meanwhile)" IsChecked="{Binding ForceWithLease}" />
              <CheckBox x:Name="ForcePushBox" Content="F_orce push (overwrites the remote branch)" IsChecked="{Binding ForcePush}" />
              <TextBlock x:Name="ForceWarning" IsVisible="{Binding ShowForceWarning}" TextWrapping="Wrap" Margin="22,0,0,0"
                         Foreground="{DynamicResource ErrorTextForeground}"
                         Text="A plain force push can destroy commits of others on the remote. Prefer force with lease." />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
