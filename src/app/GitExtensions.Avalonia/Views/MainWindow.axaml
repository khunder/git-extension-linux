<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:GitExtensions.Desktop.Views"
        xmlns:vm="using:GitExtensions.Desktop.ViewModels"
        x:Class="GitExtensions.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Git Extensions"
        Width="1200" Height="720"
        MinWidth="640" MinHeight="400">

  <Window.Styles>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.ref">
      <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight3}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,0" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Repository bar -->
    <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBox x:Name="PathBox" Text="{Binding RepositoryPath}" Watermark="Path to a Git repository">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding OpenCurrentCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" />
        <Button Grid.Column="2" Content="Open" Command="{Binding OpenCurrentCommand}" />
        <Button x:Name="RecentButton" Grid.Column="3" Content="Recent ▾" />
      </Grid>
    </Border>

    <!-- Error banner -->
    <Border x:Name="ErrorBanner" DockPanel.Dock="Top" IsVisible="{Binding HasError}" Padding="12,6"
            Background="#FDE7E9">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#7A1212" />
        <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissErrorCommand}" />
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="StatusText" Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Column="1" Width="120" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>

    <Panel>
    <views:RecentRepositoriesView x:Name="StartView" DataContext="{Binding Recent}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowStartView}" />
    <Grid ColumnDefinitions="220,Auto,3*,Auto,2*" IsVisible="{Binding HasOpenedRepository}">

      <!-- Branches / remotes / tags -->
      <views:RefsTreeView Grid.Column="0" DataContext="{Binding Refs}" />

      <GridSplitter Grid.Column="1" Width="4" />


      <!-- History -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Padding="8,6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="header" Text="History" />
            <TextBlock Text="{Binding Branch, StringFormat='on {0}'}" IsVisible="{Binding Branch, Converter={x:Static ObjectConverters.IsNotNull}}" Opacity="0.7" />
          </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Height="240" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <views:CommitDetailsView x:Name="DetailsView" DataContext="{Binding CommitDetails}" />
        </Border>
        <ListBox x:Name="CommitList" ItemsSource="{Binding Commits}" SelectedItem="{Binding SelectedCommit}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CommitItemViewModel">
              <Grid ColumnDefinitions="76,*,Auto,150" ColumnSpacing="10">
                <TextBlock Classes="mono" Text="{Binding ShortHash}" Opacity="0.65" VerticalAlignment="Center" />
                <!-- The refs badge is capped and trimmed so a commit with many refs cannot overrun the author column. -->
                <DockPanel Grid.Column="1" LastChildFill="True" ClipToBounds="True">
                  <Border DockPanel.Dock="Left" Classes="ref" IsVisible="{Binding HasRefs}" VerticalAlignment="Center" MaxWidth="120" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Refs}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Refs}" />
                  </Border>
                  <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Grid.Column="2" Text="{Binding Author}" Opacity="0.75" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding Date}" Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="3" Width="4" />

      <!-- Working tree changes -->
      <DockPanel Grid.Column="4">
        <Border DockPanel.Dock="Top" Padding="8,6">
          <TextBlock Classes="header" Text="Changes" />
        </Border>
        <Grid RowDefinitions="*,Auto,2*">
          <ListBox x:Name="ChangeList" ItemsSource="{Binding ChangedFiles}" SelectedItem="{Binding SelectedChangedFile}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ChangedFileViewModel">
                <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="8">
                  <TextBlock Classes="mono" Text="{Binding Status}" FontWeight="Bold" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="staged" FontSize="11" Opacity="0.6" IsVisible="{Binding IsStaged}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" />
          <views:DiffView Grid.Row="2" DataContext="{Binding Diff}" />
        </Grid>
      </DockPanel>

    </Grid>
    </Panel>
  </DockPanel>
</Window>
