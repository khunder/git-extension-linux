<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:GitExtensions.Desktop.Views"
        xmlns:vm="using:GitExtensions.Desktop.ViewModels"
        x:Class="GitExtensions.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Git Extensions"
        Width="1200" Height="720"
        MinWidth="640" MinHeight="400">

  <Window.Styles>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.ref">
      <Setter Property="Background" Value="{DynamicResource RefBadgeBackground}" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,0" />
    </Style>
    <Style Selector="Border.ref > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource RefBadgeForeground}" />
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Repository bar -->
    <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBox x:Name="PathBox" Text="{Binding RepositoryPath}" Watermark="Path to a Git repository">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding OpenCurrentCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" />
        <Button Grid.Column="2" Content="Open" Command="{Binding OpenCurrentCommand}" />
        <Button x:Name="RecentButton" Grid.Column="3" Content="Recent ▾" />
        <views:ThemeMenuButton Grid.Column="4" />
        <views:StashMenuButton Grid.Column="5" IsVisible="{Binding HasOpenedRepository}" />
        <Button x:Name="SettingsButton" Grid.Column="6" Content="⚙ Settings" Command="{Binding OpenSettingsCommand}" />
      </Grid>
    </Border>

    <views:RemoteOperationsView x:Name="RemoteBar" DockPanel.Dock="Top" DataContext="{Binding Remote}" />

    <!-- Error banner -->
    <Border x:Name="ErrorBanner" DockPanel.Dock="Top" IsVisible="{Binding HasError}" Padding="12,6"
            Background="{DynamicResource ErrorBannerBackground}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource ErrorBannerForeground}" />
        <Button Grid.Column="1" Content="Dismiss" Command="{Binding DismissErrorCommand}" />
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock x:Name="StatusText" Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Column="1" Width="120" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>

    <views:OutputPanelView x:Name="OutputPanel" DockPanel.Dock="Bottom" DataContext="{Binding Remote}" />

    <Panel>
    <views:RecentRepositoriesView x:Name="StartView" DataContext="{Binding Recent}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowStartView}" />
    <Grid ColumnDefinitions="220,Auto,3*,Auto,2*" IsVisible="{Binding HasOpenedRepository}">

      <!-- Branches / remotes / tags -->
      <views:RefsTreeView Grid.Column="0" DataContext="{Binding Refs}" />

      <GridSplitter Grid.Column="1" Width="4" />


      <!-- History -->
      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Padding="8,6">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="header" Text="History" />
            <TextBlock Text="{Binding Branch, StringFormat='on {0}'}" IsVisible="{Binding Branch, Converter={x:Static ObjectConverters.IsNotNull}}" Opacity="0.7" />
          </StackPanel>
        </Border>
        <views:CommitActionPromptView x:Name="CommitPrompt" DockPanel.Dock="Top" DataContext="{Binding Actions}" />
        <Border DockPanel.Dock="Bottom" Height="240" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
          <views:CommitDetailsView x:Name="DetailsView" DataContext="{Binding CommitDetails}" />
        </Border>
        <ListBox x:Name="CommitList" ItemsSource="{Binding Commits}" SelectedItem="{Binding SelectedCommit}">
          <ListBox.Styles>
            <!-- No vertical padding, so the graph lines of neighbouring rows meet. -->
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,0" />
              <Setter Property="MinHeight" Value="26" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:CommitItemViewModel">
              <Grid ColumnDefinitions="76,Auto,*,Auto,150" ColumnSpacing="10">
                <Grid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy commit hash" Command="{Binding Actions.CopyHashCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="Copy subject" Command="{Binding Actions.CopySubjectCommand}" CommandParameter="{Binding}" />
                    <Separator />
                    <MenuItem Header="Create branch here…" Command="{Binding Actions.RequestCreateBranchCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="Create tag here…" Command="{Binding Actions.RequestCreateTagCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="Checkout this commit (detached HEAD)" Command="{Binding Actions.CheckoutCommand}" CommandParameter="{Binding}" />
                    <Separator />
                    <MenuItem Header="Reset current branch to here">
                      <MenuItem Header="Soft (keep index and working tree)" Command="{Binding Actions.ResetSoftCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Mixed (keep working tree)" Command="{Binding Actions.ResetMixedCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Hard (discard all changes)…" Command="{Binding Actions.RequestHardResetCommand}" CommandParameter="{Binding}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Revert commit" Command="{Binding Actions.RevertCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="Cherry-pick commit" Command="{Binding Actions.CherryPickCommand}" CommandParameter="{Binding}" />
                  </ContextMenu>
                </Grid.ContextMenu>
                <TextBlock Classes="mono" Text="{Binding ShortHash}" Opacity="0.65" VerticalAlignment="Center" />
                <views:CommitGraphCell Grid.Column="1" Row="{Binding Graph}" LaneCount="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).GraphLaneCount}" />
                <!-- The refs badge is capped and trimmed so a commit with many refs cannot overrun the author column. -->
                <DockPanel Grid.Column="2" LastChildFill="True" ClipToBounds="True">
                  <Border DockPanel.Dock="Left" Classes="ref" IsVisible="{Binding HasRefs}" VerticalAlignment="Center" MaxWidth="120" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Refs}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Refs}" />
                  </Border>
                  <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Grid.Column="3" Text="{Binding Author}" Opacity="0.75" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding Date}" Opacity="0.6" VerticalAlignment="Center" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <GridSplitter Grid.Column="3" Width="4" />

      <!-- Working tree changes -->
      <DockPanel Grid.Column="4">
        <Border DockPanel.Dock="Top" Padding="8,6">
          <TextBlock Classes="header" Text="Changes" />
        </Border>
        <views:CommitView DockPanel.Dock="Bottom" DataContext="{Binding Commit}" />
        <Grid RowDefinitions="*,Auto,2*">
          <ListBox x:Name="ChangeList" ItemsSource="{Binding ChangedFiles}" SelectedItem="{Binding SelectedChangedFile}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ChangedFileViewModel">
                <Grid ColumnDefinitions="22,*,Auto" ColumnSpacing="8">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="File history" Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ShowFileHistoryCommand}" CommandParameter="{Binding}" />
                      <MenuItem Header="Blame" Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ShowFileBlameCommand}" CommandParameter="{Binding}" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <TextBlock Classes="mono" Text="{Binding Status}" FontWeight="Bold" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Text="staged" FontSize="11" Opacity="0.6" IsVisible="{Binding IsStaged}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" />
          <views:DiffView Grid.Row="2" DataContext="{Binding Diff}" />
        </Grid>
      </DockPanel>

    </Grid>
    <views:SettingsView x:Name="SettingsOverlay" DataContext="{Binding Settings}" IsVisible="{Binding IsOpen}" />
    <views:FileHistoryView x:Name="FileHistoryOverlay" DataContext="{Binding FileHistory}" IsVisible="{Binding IsOpen}" />
    </Panel>
  </DockPanel>
</Window>
