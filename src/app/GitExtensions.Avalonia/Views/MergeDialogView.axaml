<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.MergeDialogView"
             x:DataType="vm:MergeDialogViewModel">
  <!-- Content of the "Merge branches" dialog window (FormMergeBranch). -->
  <Border Padding="14" Background="{DynamicResource DialogBackground}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
        <Button x:Name="MergeButton" Content="_Merge" Classes="accent" IsDefault="True" MinWidth="110" Command="{Binding MergeCommand}" IsEnabled="{Binding CanRun}" />
        <Button x:Name="CloseButton" Content="Close" MinWidth="90" Command="{Binding CloseCommand}" />
      </StackPanel>
      <ProgressBar DockPanel.Dock="Bottom" Height="3" IsIndeterminate="True" IsVisible="{Binding IsRunning}" Margin="0,8,0,0" />
      <TextBox x:Name="OutputBox" DockPanel.Dock="Bottom" Text="{Binding Output}" IsVisible="{Binding HasOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
               Height="80" Classes="mono" Margin="0,8,0,0" AutomationProperties.Name="Git output" />
      <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                 Foreground="{DynamicResource ErrorTextForeground}" Margin="0,8,0,0" />
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
            <TextBlock Text="Merge into current branch" VerticalAlignment="Center" />
            <TextBox x:Name="CurrentBranchBox" Grid.Column="1" Text="{Binding CurrentBranch, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="Current branch" />
            <TextBlock Grid.Row="1" Text="Branch or commit to merge" VerticalAlignment="Center" />
            <ComboBox x:Name="TargetCombo" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" IsEditable="True"
                      ItemsSource="{Binding AllBranches}" Text="{Binding Target}" AutomationProperties.Name="Branch or commit to merge" />
          </Grid>

          <Border BorderThickness="1" BorderBrush="{DynamicResource SubtleBorderBrush}" CornerRadius="4" Padding="10">
            <StackPanel Spacing="4" IsEnabled="{Binding CanChooseFastForward}">
              <TextBlock Text="Merge commit" FontWeight="SemiBold" />
              <RadioButton x:Name="FastForwardRadio" GroupName="MergeMode" Content="Allow _fast-forward (default)" IsChecked="{Binding IsFastForward}" />
              <RadioButton x:Name="NoFastForwardRadio" GroupName="MergeMode" Content="_No fast-forward, always create a merge commit" IsChecked="{Binding IsNoFastForward}" />
              <RadioButton x:Name="FastForwardOnlyRadio" GroupName="MergeMode" Content="Fast-forward _only, refuse a merge commit" IsChecked="{Binding IsFastForwardOnly}" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="4">
            <CheckBox x:Name="SquashBox" Content="_Squash commits: stage the changes, no merge commit" IsChecked="{Binding Squash}" />
            <CheckBox x:Name="NoCommitBox" Content="No co_mmit: stop before committing the merge" IsChecked="{Binding NoCommit}" IsEnabled="{Binding CanChooseFastForward}" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
            <TextBlock Text="Merge strategy" VerticalAlignment="Center" />
            <ComboBox x:Name="StrategyCombo" Grid.Column="1" MinWidth="160" HorizontalAlignment="Left" ItemsSource="{Binding Strategies}" SelectedItem="{Binding Strategy}" AutomationProperties.Name="Merge strategy" />
            <TextBlock Grid.Row="1" Text="Merge message" VerticalAlignment="Top" Margin="0,6,0,0" />
            <TextBox x:Name="MessageBox" Grid.Row="1" Grid.Column="1" Text="{Binding Message}" AcceptsReturn="True" TextWrapping="Wrap" Height="70"
                     Watermark="Optional; the default merge message is used when empty" AutomationProperties.Name="Merge message" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
