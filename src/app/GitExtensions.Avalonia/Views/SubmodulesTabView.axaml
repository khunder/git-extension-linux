<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.SubmodulesTabView"
             x:DataType="vm:SubmodulesViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.problem"><Setter Property="Foreground" Value="{DynamicResource ErrorTextForeground}" /></Style>
    <Style Selector="TextBlock.clean"><Setter Property="Foreground" Value="{DynamicResource SuccessTextForeground}" /></Style>
    <Style Selector="TextBlock.changed"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontStyle" Value="Italic" /></Style>
  </UserControl.Styles>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8">
      <Button x:Name="InitButton" Content="Init" Command="{Binding InitCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="git submodule init" />
      <Button x:Name="UpdateButton" Content="Update" Command="{Binding UpdateCommand}" IsEnabled="{Binding HasSelection}" ToolTip.Tip="git submodule update --init --recursive" />
      <Button x:Name="UpdateAllButton" Content="Update all" Command="{Binding UpdateAllCommand}" />
      <Button x:Name="OpenButton" Content="Open as repository" Command="{Binding OpenCommand}" IsEnabled="{Binding HasSelection}" />
      <Button x:Name="SyncButton" Content="Sync URLs" Command="{Binding SyncCommand}" ToolTip.Tip="Copy the URLs of .gitmodules into the repository configuration" />
    </StackPanel>
    <Panel>
      <ListBox x:Name="SubmoduleList" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedSubmodule}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SubmoduleItemViewModel">
            <Grid ColumnDefinitions="*,80,200" ColumnSpacing="10">
              <StackPanel>
                <TextBlock Text="{Binding Path}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Url}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Url}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding ShortCommit}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" Opacity="0.7" VerticalAlignment="Center" ToolTip.Tip="Recorded commit" />
              <TextBlock Grid.Column="2" Text="{Binding StateText}" VerticalAlignment="Center"
                         Classes.problem="{Binding IsProblem}" Classes.clean="{Binding IsClean}" Classes.changed="{Binding IsChanged}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="{Binding EmptyText}" Opacity="0.6" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </Panel>
  </DockPanel>
</UserControl>
