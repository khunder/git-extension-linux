<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.RevisionOperationPromptView"
             x:DataType="vm:RevisionOperationsViewModel">
  <!-- Content of the modal dialogs for cherry pick, checkout revision, delete branches, archive, reset and clean. -->
  <Border Padding="12" Background="{DynamicResource DialogBackground}">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
        <TextBlock x:Name="RevOpsWarning" Text="{Binding Warning}" IsVisible="{Binding HasWarning}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorTextForeground}" />
        <TextBlock x:Name="RevOpsError" Text="{Binding ValidationError}" IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorTextForeground}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button x:Name="RevOpsConfirm" Classes="accent" MinWidth="90" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" />
          <Button x:Name="RevOpsCancel" MinWidth="90" Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" />
        </StackPanel>
      </StackPanel>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding ShowRevision}">
        <TextBlock Text="Revision:" VerticalAlignment="Center" />
        <TextBox x:Name="RevOpsRevision" Grid.Column="1" Text="{Binding Revision}" PlaceholderText="Revision (commit, branch, tag, HEAD~3, …)">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="2" x:Name="RevOpsUseSelected" Content="Selected commit" Command="{Binding UseSelectedCommitCommand}" />
      </Grid>

      <!-- Cherry pick -->
      <StackPanel x:Name="CherryPickOptions" Spacing="4" IsVisible="{Binding IsCherryPick}">
        <CheckBox x:Name="CherryAutoCommit" IsChecked="{Binding AutoCommit}" Content="Automatically create a commit" />
        <CheckBox x:Name="CherryAddReference" IsChecked="{Binding AddReference}" Content="Add the original commit id to the message (-x)" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Merge commit: keep parent" VerticalAlignment="Center" />
          <ComboBox x:Name="CherryMainline" ItemsSource="{Binding MainlineChoices}" SelectedItem="{Binding MainlineParent}" MinWidth="70" />
          <TextBlock Text="(0 = not a merge)" VerticalAlignment="Center" Opacity="0.7" />
        </StackPanel>
      </StackPanel>

      <!-- Checkout revision -->
      <StackPanel x:Name="CheckoutOptions" Spacing="2" IsVisible="{Binding IsCheckout}">
        <TextBlock Text="Local changes:" />
        <RadioButton GroupName="LocalChanges" IsChecked="{Binding IsKeepLocalChanges}" Content="Keep (git refuses if they would be overwritten)" />
        <RadioButton GroupName="LocalChanges" IsChecked="{Binding IsMergeLocalChanges}" Content="Merge them into the new revision" />
        <RadioButton x:Name="CheckoutDiscard" GroupName="LocalChanges" IsChecked="{Binding IsResetLocalChanges}" Content="Throw them away" />
      </StackPanel>

      <!-- Delete branch -->
      <StackPanel x:Name="DeleteBranchOptions" Spacing="4" IsVisible="{Binding IsDeleteBranch}">
        <ScrollViewer MaxHeight="160">
          <ItemsControl x:Name="DeleteBranchList" ItemsSource="{Binding Branches}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:BranchChoice">
                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" Content="{Binding Display}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <CheckBox x:Name="DeleteForce" IsChecked="{Binding ForceDelete}" Content="Force delete (-D): also unmerged local branches" />
        <TextBlock Text="Selected remote branches are deleted on the remote server (git push --delete)." Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Archive -->
      <StackPanel x:Name="ArchiveOptions" Spacing="4" IsVisible="{Binding IsArchive}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Format" VerticalAlignment="Center" />
          <ComboBox x:Name="ArchiveFormatBox" ItemsSource="{Binding ArchiveFormats}" SelectedItem="{Binding ArchiveFormat}" MinWidth="90" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="ArchiveFileBox" Text="{Binding ArchiveFile}" PlaceholderText="Archive file" />
          <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseArchiveFileCommand}" />
        </Grid>
        <TextBox x:Name="ArchivePathBox" Text="{Binding ArchivePath}" PlaceholderText="Only this path (optional, e.g. src/)" />
      </StackPanel>

      <!-- Reset -->
      <StackPanel x:Name="ResetOptions" Spacing="2" IsVisible="{Binding IsReset}">
        <RadioButton GroupName="ResetMode" IsChecked="{Binding IsSoftReset}" Content="Soft: keep the index and the working tree" />
        <RadioButton GroupName="ResetMode" IsChecked="{Binding IsMixedReset}" Content="Mixed: reset the index, keep the working tree" />
        <RadioButton x:Name="ResetHard" GroupName="ResetMode" IsChecked="{Binding IsHardReset}" Content="Hard: reset the index and the working tree" />
      </StackPanel>

      <!-- Clean -->
      <StackPanel x:Name="CleanOptions" Spacing="2" IsVisible="{Binding IsClean}">
        <CheckBox x:Name="CleanDirectories" IsChecked="{Binding IncludeDirectories}" Content="Remove untracked directories too (-d)" />
        <RadioButton GroupName="CleanIgnored" IsChecked="{Binding IsIgnoredNone}" Content="Keep ignored files" />
        <RadioButton GroupName="CleanIgnored" IsChecked="{Binding IsIgnoredInclude}" Content="Also remove ignored files (-x)" />
        <RadioButton GroupName="CleanIgnored" IsChecked="{Binding IsIgnoredOnly}" Content="Remove only ignored files (-X)" />
        <StackPanel IsVisible="{Binding HasPreview}" Spacing="2">
          <TextBlock x:Name="CleanSummary" Text="{Binding PreviewSummary}" />
          <ScrollViewer MaxHeight="160">
            <ItemsControl x:Name="CleanPreviewList" ItemsSource="{Binding CleanPreview}" />
          </ScrollViewer>
        </StackPanel>
      </StackPanel>

      </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
