<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.RemoteOperationsView"
             x:DataType="vm:RemoteOperationsViewModel"
             IsVisible="{Binding HasRepository}">
  <Border Padding="8,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="FetchButton" Content="Fetch" Command="{Binding FetchCommand}" ToolTip.Tip="Download objects and refs from the remote" />
      <Button x:Name="PullButton" Content="Pull" Command="{Binding PullCommand}" ToolTip.Tip="Fetch and merge into the current branch" />
      <Button x:Name="PushButton" Content="Push" Command="{Binding PushCommand}" ToolTip.Tip="Push the current branch (sets the upstream if it has none)" />
      <ComboBox x:Name="RemotePicker" ItemsSource="{Binding Remotes}" SelectedItem="{Binding SelectedRemote}"
                IsVisible="{Binding HasMultipleRemotes}" MinWidth="110" VerticalAlignment="Center" />
      <CheckBox Content="All remotes" IsChecked="{Binding FetchAll}" VerticalAlignment="Center" ToolTip.Tip="Fetch from every remote" />
      <CheckBox Content="Prune" IsChecked="{Binding Prune}" VerticalAlignment="Center" ToolTip.Tip="Remove remote-tracking branches that no longer exist" />
      <ProgressBar IsIndeterminate="True" Width="60" IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
      <Button x:Name="OutputToggle" Content="Output" Command="{Binding ToggleOutputCommand}" />
    </StackPanel>
  </Border>
</UserControl>
