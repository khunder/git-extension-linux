<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.FormatPatchView"
             x:DataType="vm:FormatPatchViewModel">
  <Panel Background="{DynamicResource ScrimBrush}">
    <Border x:Name="Card" MaxWidth="600" Margin="24" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Stretch"
            CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource DialogBackground}"
            BorderBrush="{DynamicResource SubtleBorderBrush}">
      <StackPanel Spacing="4">
        <TextBlock Text="Format patch" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

        <TextBlock Text="Output folder" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="FolderBox" Text="{Binding OutputFolder}" Watermark="Folder for the patch files">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" />
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
          <StackPanel Spacing="4">
            <TextBlock Text="Oldest commit (from)" />
            <TextBox x:Name="OldestBox" Text="{Binding OldestRevision}" Watermark="Commit, branch or tag" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="Newest commit (to)" />
            <TextBox x:Name="NewestBox" Text="{Binding NewestRevision}" Watermark="Commit, branch or tag" />
          </StackPanel>
        </Grid>
        <TextBlock Text="Both commits are included. Use the same commit for a single patch." Opacity="0.65" FontSize="12" TextWrapping="Wrap" />

        <StackPanel Margin="0,8,0,0">
          <RadioButton x:Name="MailRadio" GroupName="PatchFormat" Content="Mail format: one file per commit (git format-patch)" IsChecked="{Binding MailFormat}" />
          <RadioButton x:Name="DiffRadio" GroupName="PatchFormat" Content="Plain diff: one file with all changes" />
        </StackPanel>

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}" Margin="0,8,0,0" />
        <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                   Foreground="{DynamicResource ErrorTextForeground}" Margin="0,8,0,0" />
        <StackPanel IsVisible="{Binding HasResult}" Margin="0,8,0,0" Spacing="2">
          <TextBlock x:Name="ResultText" Text="{Binding ResultText}" FontWeight="SemiBold" />
          <ItemsControl x:Name="CreatedList" ItemsSource="{Binding CreatedFiles}" MaxHeight="140">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" Opacity="0.8" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
          <Button x:Name="OpenFolderButton" Content="Open folder" Command="{Binding OpenFolderCommand}" IsVisible="{Binding HasResult}" />
          <Button x:Name="CloseButton" Content="Close" Command="{Binding CloseCommand}" />
          <Button x:Name="CreateButton" Content="Create patch" Classes="accent" Command="{Binding CreateCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
