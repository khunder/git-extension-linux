<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitExtensions.Desktop.ViewModels"
        xmlns:views="using:GitExtensions.Desktop.Views"
        x:Class="GitExtensions.Desktop.Views.MergeConflictsWindow"
        x:DataType="vm:MergeConflictsViewModel"
        Title="{Binding Title}"
        Width="900" Height="600" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="8,3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SubtleBorderBrush}">
      <TextBlock x:Name="ConflictsSummary" Text="{Binding Summary}" Opacity="0.8" />
    </Border>
    <Grid ColumnDefinitions="260,Auto,*">
      <ListBox x:Name="ConflictFilesList" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ChangedFileViewModel">
            <Grid ColumnDefinitions="20,*" ToolTip.Tip="{Binding Name}">
              <TextBlock Text="U" FontWeight="Bold" Foreground="{DynamicResource ErrorTextForeground}" />
              <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <GridSplitter Grid.Column="1" Width="5" Background="Transparent" ResizeDirection="Columns" />
      <Panel Grid.Column="2">
        <views:ConflictResolverView x:Name="ConflictPanel" DataContext="{Binding Resolver}" IsVisible="{Binding IsActive}" />
        <TextBlock x:Name="NoConflictsText" Text="{Binding Summary}" Margin="16" Opacity="0.6" IsVisible="{Binding HasNoConflicts}" />
      </Panel>
    </Grid>
  </DockPanel>
</Window>
