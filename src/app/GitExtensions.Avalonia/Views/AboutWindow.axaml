<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitExtensions.Desktop.Views.AboutWindow"
        Title="About Git Extensions"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="10">
    <TextBlock Text="Git Extensions" FontSize="22" FontWeight="SemiBold" />
    <TextBlock x:Name="VersionText" Opacity="0.75" />
    <TextBlock TextWrapping="Wrap" Text="A graphical user interface for Git that makes working with Git repositories more intuitive. This is the cross-platform edition." />
    <TextBlock x:Name="LicenseText" Opacity="0.75" Text="Licensed under the GNU General Public License v3." />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button x:Name="WebsiteButton" Content="Website" Click="OnWebsite" />
      <Button x:Name="CloseButton" Content="Close" IsDefault="True" IsCancel="True" Click="OnClose" />
    </StackPanel>
  </StackPanel>
</Window>
