<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.BlameView"
             x:DataType="vm:BlameViewModel">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BlameBandBackground" Color="#0F000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BlameBandBackground" Color="#14FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.band"><Setter Property="Background" Value="{DynamicResource BlameBandBackground}" /></Style>
    <Style Selector="ListBox.blame ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="18" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <ListBox x:Name="BlameLines" Classes="blame" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
             ScrollViewer.HorizontalScrollBarVisibility="Auto">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:BlameLineViewModel">
          <Border Classes.band="{Binding IsAlternate}" ToolTip.Tip="{Binding ToolTip}">
            <Grid ColumnDefinitions="76,130,84,52,Auto">
              <TextBlock Text="{Binding ShortHash}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="12" Opacity="0.65" Margin="6,0,0,0" />
              <TextBlock Grid.Column="1" Text="{Binding Author}" FontSize="12" Opacity="0.85" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
              <TextBlock Grid.Column="2" Text="{Binding Date}" FontSize="12" Opacity="0.6" />
              <TextBlock Grid.Column="3" Text="{Binding LineNumber}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="12" Opacity="0.5" TextAlignment="Right" Margin="0,0,8,0" />
              <TextBlock Grid.Column="4" Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="12" TextWrapping="NoWrap" />
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="BlameMessage" Text="{Binding Message}" Opacity="0.6" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top"
               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </Panel>
</UserControl>
