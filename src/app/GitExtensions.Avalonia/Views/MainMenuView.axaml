<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.MainMenuView"
             x:DataType="vm:MainWindowViewModel">

  <UserControl.Styles>
    <!-- Dense, desktop-style menu bar. -->
    <Style Selector="Menu > MenuItem">
      <Setter Property="Padding" Value="9,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="26" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="FontSize" Value="13" />
    </Style>
    <!-- Compact entries so the long Commands menu fits a small window. -->
    <Style Selector="MenuItem MenuItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="MenuItem > Separator">
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <!-- A feature that does not exist yet: shown (like the original) but disabled. -->
    <Style Selector="MenuItem.stub">
      <Setter Property="IsEnabled" Value="False" />
      <Setter Property="ToolTip.Tip" Value="Not available yet" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>
  </UserControl.Styles>

  <Menu x:Name="MainMenu">
    <!-- Start -->
    <MenuItem x:Name="StartMenu" Header="_Start">
      <MenuItem x:Name="OpenMenuItem" Header="_Open…" InputGesture="Ctrl+O" Command="{Binding BrowseCommand}" />
      <MenuItem x:Name="OpenRecentMenu" Header="Open _recent" />
      <MenuItem x:Name="CloneMenuItem" Header="_Clone repository…" Command="{Binding ShowCloneCommand}" />
      <MenuItem x:Name="InitMenuItem" Header="Create _new repository…" Command="{Binding ShowInitCommand}" />
      <MenuItem Header="_Favorite repositories…" Classes="stub" />
      <Separator />
      <MenuItem x:Name="SettingsMenuItem" Header="_Settings…" InputGesture="Ctrl+," Command="{Binding OpenSettingsCommand}" />
      <Separator />
      <MenuItem x:Name="ExitMenuItem" Header="E_xit" Click="OnExit" />
    </MenuItem>

    <!-- Dashboard: only while the start page is shown. -->
    <MenuItem x:Name="DashboardMenu" Header="_Dashboard" IsVisible="{Binding ShowStartView}">
      <MenuItem x:Name="DashboardRefreshMenuItem" Header="_Refresh" InputGesture="F5" Command="{Binding RefreshDashboardCommand}" />
    </MenuItem>

    <!-- Repository -->
    <MenuItem x:Name="RepositoryMenu" Header="_Repository" IsVisible="{Binding HasOpenedRepository}">
      <MenuItem x:Name="RefreshMenuItem" Header="_Refresh" InputGesture="F5" Command="{Binding RefreshCommand}" />
      <MenuItem x:Name="FileExplorerMenuItem" Header="File E_xplorer" Command="{Binding OpenFileExplorerCommand}" />
      <Separator />
      <MenuItem Header="Remote repositor_ies…" Classes="stub" />
      <Separator />
      <MenuItem x:Name="SubmodulesMenuItem" Header="Manage s_ubmodules…" Command="{Binding ShowSubmodulesCommand}" />
      <MenuItem x:Name="UpdateSubmodulesMenuItem" Header="_Update all submodules" Command="{Binding UpdateAllSubmodulesCommand}" />
      <MenuItem x:Name="SyncSubmodulesMenuItem" Header="S_ynchronize all submodules" Command="{Binding SynchronizeAllSubmodulesCommand}" />
      <Separator />
      <MenuItem x:Name="WorktreesMenuItem" Header="Manage _worktrees…" Command="{Binding ShowWorktreesCommand}" />
      <Separator />
      <MenuItem x:Name="EditGitIgnoreMenuItem" Header="Edit .git_ignore" Command="{Binding EditWorkingTreeFileCommand}" CommandParameter=".gitignore" />
      <MenuItem x:Name="EditExcludeMenuItem" Header="Edit .git/_info/exclude" Command="{Binding EditGitDirectoryFileCommand}" CommandParameter="info/exclude" />
      <MenuItem x:Name="EditGitAttributesMenuItem" Header="Edit .git_attributes" Command="{Binding EditWorkingTreeFileCommand}" CommandParameter=".gitattributes" />
      <MenuItem x:Name="EditMailmapMenuItem" Header="Edit .mail_map" Command="{Binding EditWorkingTreeFileCommand}" CommandParameter=".mailmap" />
      <Separator />
      <MenuItem Header="Git _maintenance">
        <MenuItem x:Name="CompressMenuItem" Header="_Compress git database" Command="{Binding CompressDatabaseCommand}" />
        <MenuItem Header="_Recover lost objects…" Classes="stub" />
        <MenuItem x:Name="DeleteIndexLockMenuItem" Header="Delete index._lock" Command="{Binding DeleteIndexLockCommand}" />
        <Separator />
        <MenuItem x:Name="EditConfigMenuItem" Header="Edit .git/_config" Command="{Binding EditGitDirectoryFileCommand}" CommandParameter="config" />
      </MenuItem>
      <MenuItem x:Name="RepositorySettingsMenuItem" Header="Repository se_ttings…" Command="{Binding OpenSettingsCommand}" />
      <Separator />
      <MenuItem x:Name="CloseMenuItem" Header="_Close (go to Dashboard)" Command="{Binding CloseRepositoryCommand}" />
    </MenuItem>

    <!-- Navigate -->
    <MenuItem x:Name="NavigateMenu" Header="_Navigate" IsVisible="{Binding HasOpenedRepository}">
      <MenuItem Header="Go to _commit…" Classes="stub" />
      <MenuItem x:Name="GoToCurrentMenuItem" Header="Go to c_urrent revision" Command="{Binding GoToCurrentRevisionCommand}" />
      <Separator />
      <MenuItem x:Name="GoToParentMenuItem" Header="Go to _parent commit" Command="{Binding GoToParentCommitCommand}" />
      <MenuItem x:Name="GoToChildMenuItem" Header="Go to c_hild commit" Command="{Binding GoToChildCommitCommand}" />
      <Separator />
      <MenuItem x:Name="NextCommitMenuItem" Header="_Next change in list" InputGesture="J" Command="{Binding NextChangeCommand}" />
      <MenuItem x:Name="PreviousCommitMenuItem" Header="Pre_vious change in list" InputGesture="K" Command="{Binding PreviousChangeCommand}" />
      <Separator />
      <MenuItem Header="Navigate _backward" Classes="stub" />
      <MenuItem Header="Navigate _forward" Classes="stub" />
    </MenuItem>

    <!-- View -->
    <MenuItem x:Name="ViewMenu" Header="_View" IsVisible="{Binding HasOpenedRepository}">
      <MenuItem x:Name="LeftPanelMenuItem" Header="Show/hide _left panel" InputGesture="Ctrl+B" Command="{Binding ToggleLeftPanelCommand}" />
      <MenuItem x:Name="OutputMenuItem" Header="Show/hide _output panel" InputGesture="Ctrl+Shift+O" Command="{Binding Remote.ToggleOutputCommand}" />
      <Separator />
      <MenuItem Header="Layout of the commit _info">
        <MenuItem Header="_Below" Classes="stub" />
        <MenuItem Header="_Left" Classes="stub" />
        <MenuItem Header="_Right" Classes="stub" />
      </MenuItem>
      <MenuItem Header="Show _tabs">
        <MenuItem Header="_Commit" Classes="stub" />
        <MenuItem Header="_Diff" Classes="stub" />
        <MenuItem Header="_File tree" Classes="stub" />
        <MenuItem Header="C_onsole" Classes="stub" />
        <MenuItem Header="_Build report" Classes="stub" />
      </MenuItem>
      <MenuItem Header="F_ilters" Classes="stub" />
      <MenuItem Header="Show remote _branches" Classes="stub" />
      <MenuItem Header="Show _tags" Classes="stub" />
      <Separator />
      <MenuItem x:Name="ViewRefreshMenuItem" Header="_Refresh" InputGesture="F5" Command="{Binding RefreshCommand}" />
    </MenuItem>

    <!-- Commands -->
    <MenuItem x:Name="CommandsMenu" Header="_Commands" IsVisible="{Binding HasOpenedRepository}">
      <MenuItem x:Name="CommitMenuItem" Header="_Commit…" InputGesture="Ctrl+K" Command="{Binding ShowCommitWindowCommand}" />
      <MenuItem x:Name="UndoCommitMenuItem" Header="_Undo last commit…" Command="{Binding UndoLastCommitCommand}" />
      <MenuItem x:Name="PullMenuItem" Header="Pu_ll…" InputGesture="Ctrl+Shift+L" Command="{Binding Remote.PullCommand}" />
      <MenuItem x:Name="FetchMenuItem" Header="_Fetch" InputGesture="Ctrl+Shift+F" Command="{Binding Remote.FetchCommand}" />
      <MenuItem x:Name="PushMenuItem" Header="_Push…" InputGesture="Ctrl+Shift+K" Command="{Binding Remote.PushCommand}" />
      <Separator />
      <MenuItem x:Name="ManageStashesMenuItem" Header="Manage _stashes…" InputGesture="Ctrl+Shift+T" Command="{Binding ManageStashesCommand}" />
      <MenuItem Header="_Reset changes…" Classes="stub" />
      <MenuItem Header="Clean _working directory…" Classes="stub" />
      <Separator />
      <MenuItem x:Name="CreateBranchMenuItem" Header="Create _branch…" Command="{Binding CreateBranchCommand}" />
      <MenuItem Header="_Delete branch…" Classes="stub" />
      <MenuItem x:Name="CheckoutBranchMenuItem" Header="Chec_kout branch…" Command="{Binding CheckoutBranchCommand}" />
      <MenuItem x:Name="MergeMenuItem" Header="_Merge branches…" Command="{Binding MergeSelectedRefCommand}" IsEnabled="{Binding CanMergeSelectedRef}" ToolTip.Tip="Merges the branch selected in the left panel into the current branch" ToolTip.ShowOnDisabled="True" />
      <MenuItem x:Name="RebaseMenuItem" Header="Re_base…" Command="{Binding RebaseOntoSelectedRefCommand}" IsEnabled="{Binding CanMergeSelectedRef}" ToolTip.Tip="Rebases the current branch onto the branch selected in the left panel" ToolTip.ShowOnDisabled="True" />
      <MenuItem Header="S_olve merge conflicts…" Classes="stub" />
      <Separator />
      <MenuItem x:Name="CreateTagMenuItem" Header="Create _tag…" Command="{Binding CreateTagCommand}" />
      <MenuItem x:Name="DeleteTagMenuItem" Header="Delete t_ag…" Command="{Binding DeleteSelectedTagCommand}" IsEnabled="{Binding IsSelectedRefTag}" ToolTip.Tip="Deletes the tag selected in the left panel" ToolTip.ShowOnDisabled="True" />
      <Separator />
      <MenuItem Header="Cherry _pick…" Classes="stub" />
      <MenuItem Header="_Archive revision…" Classes="stub" />
      <MenuItem Header="Checkout _revision…" Classes="stub" />
      <MenuItem Header="Bis_ect…" Classes="stub" />
      <MenuItem x:Name="ReflogMenuItem" Header="Show re_flog…" Command="{Binding ShowReflogCommand}" />
      <Separator />
      <MenuItem Header="Format pa_tch…" Classes="stub" />
      <MenuItem Header="_Apply patch…" Classes="stub" />
      <MenuItem Header="_View patch file…" Classes="stub" />
    </MenuItem>

    <!-- Plugins -->
    <MenuItem x:Name="PluginsMenu" Header="_Plugins">
      <MenuItem Header="(no plugins)" IsEnabled="False" />
      <Separator />
      <MenuItem Header="Plugins _settings…" Classes="stub" />
    </MenuItem>

    <!-- Tools -->
    <MenuItem x:Name="ToolsMenu" Header="_Tools">
      <MenuItem x:Name="ShellMenuItem" Header="Git _bash / terminal" IsEnabled="{Binding HasOpenedRepository}" Command="{Binding OpenShellCommand}" />
      <MenuItem Header="Start authentication _agent" Classes="stub" />
      <MenuItem Header="_Generate or import key" Classes="stub" />
      <Separator />
      <MenuItem x:Name="ThemeMenu" Header="_Theme">
        <MenuItem x:Name="ThemeSystemMenuItem" Header="_System" Tag="System" ToggleType="Radio" GroupName="Theme" Click="OnThemeClick" />
        <MenuItem x:Name="ThemeLightMenuItem" Header="_Light" Tag="Light" ToggleType="Radio" GroupName="Theme" Click="OnThemeClick" />
        <MenuItem x:Name="ThemeDarkMenuItem" Header="_Dark" Tag="Dark" ToggleType="Radio" GroupName="Theme" Click="OnThemeClick" />
      </MenuItem>
    </MenuItem>

    <!-- Help -->
    <MenuItem x:Name="HelpMenu" Header="_Help">
      <MenuItem x:Name="DocumentationMenuItem" Header="_Documentation" Command="{Binding OpenDocumentationCommand}" />
      <MenuItem x:Name="ReportIssueMenuItem" Header="_Report an issue" Command="{Binding ReportIssueCommand}" />
      <MenuItem x:Name="ChangelogMenuItem" Header="_Changelog" Command="{Binding OpenChangelogCommand}" />
      <MenuItem x:Name="ShortcutsMenuItem" Header="_Keyboard shortcuts" InputGesture="F1" Command="{Binding ShowShortcutsCommand}" />
      <Separator />
      <MenuItem x:Name="AboutMenuItem" Header="_About Git Extensions" Command="{Binding ShowAboutCommand}" />
      <MenuItem Header="Check for _updates" Classes="stub" />
    </MenuItem>
  </Menu>
</UserControl>
