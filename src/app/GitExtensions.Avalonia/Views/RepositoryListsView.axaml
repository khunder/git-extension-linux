<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.RepositoryListsView"
             x:DataType="vm:RepositoryListsViewModel">
      <DockPanel x:Name="Card" Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
          <TextBlock x:Name="MessageText" Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="RemoveMissingButton" Content="Remove missing" Command="{Binding RemoveMissingCommand}" />
            <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" />
            <Button x:Name="SaveButton" Content="Save" Classes="accent" IsDefault="True" Command="{Binding SaveCommand}" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="Auto,160,24,Auto,160" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
              <TextBlock Text="Repositories on top" VerticalAlignment="Center" />
              <NumericUpDown x:Name="MaxTopBox" Grid.Column="1" Minimum="0" Maximum="100" Increment="1" FormatString="0" Value="{Binding MaxTopRepositories}" AutomationProperties.Name="Repositories on top" />
              <TextBlock Grid.Column="3" Text="Repositories kept" VerticalAlignment="Center" />
              <NumericUpDown x:Name="HistorySizeBox" Grid.Column="4" Minimum="1" Maximum="500" Increment="1" FormatString="0" Value="{Binding HistorySize}" AutomationProperties.Name="Repositories kept" />
              <TextBlock Grid.Row="1" Text="Shorten paths" VerticalAlignment="Center" />
              <ComboBox x:Name="ShorteningBox" Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static vm:RepositoryListsViewModel.ShorteningNames}" SelectedIndex="{Binding ShorteningIndex}" HorizontalAlignment="Stretch" />
              <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Orientation="Horizontal" Spacing="16">
                <CheckBox x:Name="HideTopBox" Content="Hide top repositories from the recent list" IsChecked="{Binding HideTopFromRecent}" />
                <CheckBox x:Name="SortTopBox" Content="Sort top list" IsChecked="{Binding SortTop}" />
                <CheckBox x:Name="SortRecentBox" Content="Sort recent list" IsChecked="{Binding SortRecent}" />
              </StackPanel>
            </Grid>

            <TextBlock Text="Recent repositories" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListBox x:Name="RecentList" ItemsSource="{Binding Recent}" MinHeight="120" AutomationProperties.Name="Recent repositories">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RepositoryListRow">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{Binding PinText}" Padding="8,2" Command="{Binding $parent[UserControl].((vm:RepositoryListsViewModel)DataContext).TogglePinCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="2" Content="Remove" Padding="8,2" Command="{Binding $parent[UserControl].((vm:RepositoryListsViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Favorites" FontWeight="SemiBold" Margin="0,10,0,0" />
            <ListBox x:Name="FavoriteList" ItemsSource="{Binding Favorites}" MinHeight="120" AutomationProperties.Name="Favorite repositories">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RepositoryListRow">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Category}" Opacity="0.7" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="Remove" Padding="8,2" Command="{Binding $parent[UserControl].((vm:RepositoryListsViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Changes apply when you save." Opacity="0.65" FontSize="12" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
</UserControl>
