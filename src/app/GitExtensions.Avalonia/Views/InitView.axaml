<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.InitView"
             x:DataType="vm:InitViewModel">
      <StackPanel Spacing="4" x:Name="Card" Margin="16">
        <TextBlock Text="Folder (created if it does not exist)" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox x:Name="FolderBox" Text="{Binding Folder}" PlaceholderText="Path of the new repository">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding InitCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" />
        </Grid>
        <TextBlock x:Name="FolderErrorText" Text="{Binding FolderError}" IsVisible="{Binding HasFolderError}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource ErrorTextForeground}" />

        <TextBlock Text="Initial branch name (optional)" Margin="0,8,0,0" />
        <TextBox x:Name="BranchBox" Text="{Binding InitialBranch}" PlaceholderText="Git's default (usually main or master)" />
        <TextBlock x:Name="BranchErrorText" Text="{Binding BranchError}" IsVisible="{Binding HasBranchError}" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource ErrorTextForeground}" />

        <CheckBox x:Name="ReadmeBox" Content="Create initial commit with README.md" IsChecked="{Binding CreateReadmeCommit}" Margin="0,8,0,0" />
        <TextBlock Text="Needs your name and email (user.name and user.email) to be configured." Opacity="0.65" FontSize="12" TextWrapping="Wrap" />

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRunning}" Margin="0,8,0,0" />
        <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextWrapping="Wrap"
                   Foreground="{DynamicResource ErrorTextForeground}" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
          <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" />
          <Button x:Name="InitButton" Content="Init" Classes="accent" IsDefault="True" Command="{Binding InitCommand}" />
        </StackPanel>
      </StackPanel>
</UserControl>
