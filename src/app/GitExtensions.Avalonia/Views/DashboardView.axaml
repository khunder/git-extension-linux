<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             xmlns:views="using:GitExtensions.Desktop.Views"
             x:Class="GitExtensions.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <UserControl.Styles>
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundListLowBrush}" />
    </Style>
    <Style Selector="ListBox.repos ListBoxItem">
      <Setter Property="Padding" Value="12,4" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="230,Auto,*">
    <!-- Left column: the ways to get a repository -->
    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="16,20,16,12" Spacing="2">
          <TextBlock Text="Git Extensions" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Dashboard" Opacity="0.65" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Margin="4,0">
          <Button x:Name="CreateButton" Classes="link" AutomationProperties.Name="Create new repository" Command="{Binding CreateNewCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6"><views:AppIcon IconName="RepoCreate" /><TextBlock Text="Create new repository…" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button x:Name="OpenButton" Classes="link" AutomationProperties.Name="Open repository" Command="{Binding BrowseCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6"><views:AppIcon IconName="RepoOpen" /><TextBlock Text="Open repository…" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button x:Name="CloneButton" Classes="link" AutomationProperties.Name="Clone repository" Command="{Binding CloneRepositoryCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6"><views:AppIcon IconName="CloneRepoGit" /><TextBlock Text="Clone repository…" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button x:Name="SettingsButton" Classes="link" AutomationProperties.Name="Settings"
                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenSettingsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6"><views:AppIcon IconName="Settings" /><TextBlock Text="Settings…" VerticalAlignment="Center" /></StackPanel>
          </Button>
        </StackPanel>
        <Panel />
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Width="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

    <!-- Main area: the repository lists -->
    <DockPanel Grid.Column="2">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,16,16,8">
        <TextBlock Text="Recent and favorite repositories" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBox x:Name="DashboardFilterBox" Grid.Column="1" Width="240" AutomationProperties.Name="Filter repositories" Text="{Binding Filter}" Watermark="Filter repositories…" />
      </Grid>
      <Border x:Name="CategoryEditor" DockPanel.Dock="Top" IsVisible="{Binding IsEditorOpen}" Margin="16,0,16,8" Padding="12" CornerRadius="6" BorderThickness="1"
              BorderBrush="{DynamicResource SubtleBorderBrush}" Background="{DynamicResource CardBackground}">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding EditorTitle}" FontWeight="SemiBold" />
          <TextBlock IsVisible="{Binding IsDeleting}"
                     Text="The repositories are removed from the favorites; this cannot be undone." TextWrapping="Wrap" />
          <ItemsControl x:Name="ExistingCategoryList" ItemsSource="{Binding ExistingCategories}" IsVisible="{Binding IsAssigning}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <Button Content="{Binding}" Margin="0,0,6,4" Padding="8,2"
                        Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).PickCategoryCommand}" CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBox x:Name="CategoryNameBox" Text="{Binding EditorText}" IsVisible="{Binding IsTextEditor}" Watermark="Category name" AutomationProperties.Name="Category name">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding ApplyEditorCommand}" />
              <KeyBinding Gesture="Escape" Command="{Binding CancelEditorCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <TextBlock x:Name="CategoryErrorText" Text="{Binding EditorError}" IsVisible="{Binding HasEditorError}" Foreground="{DynamicResource ErrorTextForeground}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="CategoryApplyButton" Content="OK" Classes="accent" Command="{Binding ApplyEditorCommand}" />
            <Button x:Name="CategoryCancelButton" Content="Cancel" Command="{Binding CancelEditorCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Panel>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsEmpty}">
          <ItemsControl x:Name="CategoryList" ItemsSource="{Binding Categories}" Margin="8,0,8,16">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DashboardCategory">
                <StackPanel Margin="0,0,0,12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="categoryTitle" Text="{Binding Header}" FontWeight="SemiBold" FontSize="14" Margin="12,6,12,4" />
                    <Button Grid.Column="1" Classes="categoryActions" Content="Actions ▾" IsVisible="{Binding IsFavoriteCategory}" Padding="8,2" Background="Transparent" BorderThickness="0"
                            AutomationProperties.Name="Category actions">
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="Rename category…" Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).BeginRenameCategoryCommand}" CommandParameter="{Binding}" />
                          <MenuItem Header="Delete category…" Command="{Binding $parent[UserControl].((vm:DashboardViewModel)DataContext).BeginDeleteCategoryCommand}" CommandParameter="{Binding}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                  <ListBox Classes="repos" ItemsSource="{Binding Entries}" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:DashboardEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent">
                          <views:AppIcon Grid.Column="0" IconName="GitLogo16" Margin="0,0,10,0" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="pinned" IsVisible="{Binding IsPinned}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                              <TextBlock Text="★" IsVisible="{Binding IsFavorite}" Foreground="{DynamicResource AccentTextForeground}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                            </StackPanel>
                            <TextBlock Text="{Binding Path}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Branch}" IsVisible="{Binding HasBranch}" VerticalAlignment="Center" Margin="12,0,4,0" Foreground="{DynamicResource AccentTextForeground}" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel IsVisible="{Binding IsEmpty}" Spacing="6" Margin="0,40" HorizontalAlignment="Center" VerticalAlignment="Top">
          <TextBlock Text="No repositories to show" FontSize="16" HorizontalAlignment="Center" />
          <TextBlock Text="Open or clone a repository; it will be listed here next time."
                     Opacity="0.65" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
        </StackPanel>
      </Panel>
    </DockPanel>
  </Grid>
</UserControl>
