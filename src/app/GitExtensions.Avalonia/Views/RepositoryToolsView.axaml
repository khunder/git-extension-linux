<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             xmlns:views="using:GitExtensions.Desktop.Views"
             x:Class="GitExtensions.Desktop.Views.RepositoryToolsView"
             x:DataType="vm:RepositoryToolsViewModel"
             Width="860" Height="480">

  <DockPanel>
    <Border DockPanel.Dock="Top" IsVisible="{Binding HasBackPath}" Padding="8,4">
      <Button x:Name="BackButton" Content="{Binding BackText}" Command="{Binding GoBackCommand}" HorizontalAlignment="Left" />
    </Border>
    <ProgressBar DockPanel.Dock="Bottom" Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
    <TabControl x:Name="ToolsTabs" SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="Reflog">
        <views:ReflogTabView DataContext="{Binding Reflog}" />
      </TabItem>
      <TabItem Header="Submodules">
        <views:SubmodulesTabView DataContext="{Binding Submodules}" />
      </TabItem>
      <TabItem Header="Worktrees">
        <views:WorktreesTabView DataContext="{Binding Worktrees}" />
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
