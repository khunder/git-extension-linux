<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitExtensions.Desktop.ViewModels"
        xmlns:views="using:GitExtensions.Desktop.Views"
        x:Class="GitExtensions.Desktop.Views.CommitWindow"
        x:DataType="vm:CommitWindowViewModel"
        Title="{Binding Title}"
        Width="1000" Height="700" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <TreeDataTemplate x:Key="ChangeTreeTemplate" ItemsSource="{Binding Children}" x:DataType="vm:ChangeTreeNode">
      <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" ToolTip.Tip="{Binding Description}">
        <views:AppIcon IconName="{Binding StatusIcon}" />
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
      </StackPanel>
    </TreeDataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TreeViewItem" x:DataType="vm:ChangeTreeNode">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.glyph">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource AccentTextForeground}" />
    </Style>
    <Style Selector="TextBlock.glyph.added"><Setter Property="Foreground" Value="{DynamicResource SuccessTextForeground}" /></Style>
    <Style Selector="TextBlock.glyph.deleted"><Setter Property="Foreground" Value="{DynamicResource ErrorTextForeground}" /></Style>
    <Style Selector="TextBlock.glyph.conflict"><Setter Property="Foreground" Value="{DynamicResource ErrorTextForeground}" /></Style>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.tool">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.sectionHeader">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    </Style>
    <!-- Compact rows like the original's file lists. -->
    <Style Selector="ListBoxItem">
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">

    <!-- Toolbar -->
    <Border Grid.Row="0" Padding="6,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SubtleBorderBrush}">
      <DockPanel LastChildFill="True">
        <StackPanel Orientation="Horizontal" Spacing="4" DockPanel.Dock="Left">
          <Button x:Name="RefreshButton" Classes="tool" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh the list of changes (F5)">
            <StackPanel Orientation="Horizontal" Spacing="4"><views:AppIcon IconName="ReloadRevisions" /><AccessText Text="Refresh" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <ToggleButton x:Name="UntrackedToggle" Classes="tool" Content="Show untracked files" IsChecked="{Binding ShowUntracked}" />
          <ToggleButton x:Name="TreeToggle" Classes="tool" IsChecked="{Binding ShowTree}" ToolTip.Tip="Tree view: group the changed files by folder" AutomationProperties.Name="Tree view">
            <views:AppIcon IconName="FileTree" />
          </ToggleButton>
          <Border Width="1" Margin="4,2" Background="{DynamicResource SubtleBorderBrush}" />
          <Button x:Name="EditGitIgnoreButton" Classes="tool" Content="Edit .gitignore" Command="{Binding EditGitIgnoreCommand}" ToolTip.Tip="Open the .gitignore of the repository in your editor" />
          <Border Width="1" Margin="4,2" Background="{DynamicResource SubtleBorderBrush}" />
          <Button x:Name="StageAllButton" Classes="tool" Command="{Binding StageAllCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4"><views:AppIcon IconName="StageAll" /><AccessText Text="Stage all" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button x:Name="UnstageAllButton" Classes="tool" Command="{Binding UnstageAllCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4"><views:AppIcon IconName="UnstageAll" /><AccessText Text="Unstage all" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Border Width="1" Margin="4,2" Background="{DynamicResource SubtleBorderBrush}" />
          <Button x:Name="ResetAllToolbarButton" Classes="tool" Command="{Binding ResetAllCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4"><views:AppIcon IconName="ResetWorkingDirChanges" /><AccessText Text="Reset all changes…" VerticalAlignment="Center" /></StackPanel>
          </Button>
        </StackPanel>
        <SplitButton x:Name="ToolbarCommitButton" DockPanel.Dock="Right" Command="{Binding CommitNowCommand}" MinHeight="26" Padding="10,3">
          <StackPanel Orientation="Horizontal" Spacing="4"><views:AppIcon IconName="RepoStateClean" /><AccessText Text="Commit" VerticalAlignment="Center" /></StackPanel>
          <SplitButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem x:Name="ToolbarCommitItem" Header="Commit" Command="{Binding CommitNowCommand}" InputGesture="Ctrl+Enter" />
              <MenuItem x:Name="ToolbarCommitPushItem" Header="Commit &amp; push" Command="{Binding CommitAndPushCommand}" />
            </MenuFlyout>
          </SplitButton.Flyout>
        </SplitButton>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0" Spacing="4">
          <TextBlock Text="Filter:" VerticalAlignment="Center" Opacity="0.7" />
          <TextBox x:Name="FilterBox" Width="130" MinHeight="26" Padding="6,3" Text="{Binding Filter}" PlaceholderText="Filter files" />
        </StackPanel>
        <Panel />
      </DockPanel>
    </Border>

    <!-- Confirmation bars -->
    <Border x:Name="ResetConfirmation" Grid.Row="1" Padding="8,6" IsVisible="{Binding IsConfirmingReset}" Background="{DynamicResource ErrorBannerBackground}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="ResetConfirmationMessage" Text="{Binding ResetConfirmationText}" Foreground="{DynamicResource ErrorBannerForeground}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="ConfirmResetButton" Grid.Column="1" Content="Reset" Command="{Binding ConfirmResetCommand}" Margin="8,0,6,0" />
        <Button x:Name="CancelResetButton" Grid.Column="2" Content="Cancel" Command="{Binding CancelResetCommand}" />
      </Grid>
    </Border>
    <Border x:Name="CloseConfirmation" Grid.Row="2" Padding="8,6" IsVisible="{Binding IsConfirmingClose}" Background="{DynamicResource ErrorBannerBackground}">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="The commit message has not been committed. Discard it and close the window?" Foreground="{DynamicResource ErrorBannerForeground}" VerticalAlignment="Center" TextWrapping="Wrap" />
        <Button x:Name="DiscardCloseButton" Grid.Column="1" Content="Discard and close" Command="{Binding DiscardAndCloseCommand}" Margin="8,0,6,0" />
        <Button x:Name="KeepEditingButton" Grid.Column="2" Content="Keep editing" Command="{Binding KeepEditingCommand}" />
      </Grid>
    </Border>

    <!-- Lists and diff -->
    <Grid x:Name="MainArea" Grid.Row="3" ColumnDefinitions="380,Auto,*" MinHeight="150">
      <!-- Like the original: the unstaged files on top, a bar with the unstage (up) and stage (down) buttons between the lists, the staged files below and the committer at the bottom. -->
      <Grid RowDefinitions="*,Auto,*,Auto">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="sectionHeader">
            <TextBlock x:Name="UnstagedHeader" Text="{Binding UnstagedHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Border>
          <Panel>
            <TreeView x:Name="UnstagedTreeView" ItemsSource="{Binding UnstagedTree}" SelectionMode="Multiple" IsVisible="{Binding ShowTree}"
                      SelectionChanged="OnUnstagedTreeSelectionChanged" DoubleTapped="OnUnstagedDoubleTapped" BorderThickness="0"
                      ItemTemplate="{StaticResource ChangeTreeTemplate}" />
            <ListBox x:Name="UnstagedList" ItemsSource="{Binding Unstaged}" SelectedItem="{Binding SelectedUnstaged}" SelectionMode="Multiple" IsVisible="{Binding ShowList}"
                     SelectionChanged="OnUnstagedSelectionChanged" DoubleTapped="OnUnstagedDoubleTapped" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ChangedFileViewModel">
                  <Grid ColumnDefinitions="20,Auto,*" ColumnSpacing="6" ToolTip.Tip="{Binding Description}">
                    <views:AppIcon IconName="{Binding StatusIcon}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding FileName}" />
                    <TextBlock Grid.Column="2" Text="{Binding Directory}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoUnstagedText" Text="There are no unstaged changes" Opacity="0.55" Margin="10" IsHitTestVisible="False" IsVisible="{Binding HasNoUnstaged}" />
          </Panel>
        </DockPanel>
        <GridSplitter Grid.Row="1" Height="4" Background="Transparent" HorizontalAlignment="Stretch" ResizeDirection="Rows" />
        <DockPanel Grid.Row="2">
          <Border x:Name="StageBar" DockPanel.Dock="Top" Classes="sectionHeader" BorderThickness="0,1,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
              <Button x:Name="UnstageAllBarButton" Classes="tool" MinHeight="22" Padding="4,1" Command="{Binding UnstageAllCommand}" ToolTip.Tip="Unstage all" AutomationProperties.Name="Unstage all">
                <views:AppIcon IconName="UnstageAll" />
              </Button>
              <Border Grid.Column="1" Width="1" Margin="3,2" Background="{DynamicResource SubtleBorderBrush}" />
              <Button x:Name="UnstageSelectedButton" Grid.Column="2" Classes="tool" MinHeight="22" Padding="6,1"
                      Command="{Binding UnstageSelectedCommand}" ToolTip.Tip="Unstage the selected files (U, or double-click a file)">
                <StackPanel Orientation="Horizontal" Spacing="4"><views:AppIcon IconName="Unstage" /><AccessText Text="Unstage" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button x:Name="StageSelectedButton" Grid.Column="4" Classes="tool" MinHeight="22" Padding="6,1"
                      Command="{Binding StageSelectedCommand}" ToolTip.Tip="Stage the selected files (S, or double-click a file)">
                <StackPanel Orientation="Horizontal" Spacing="4"><AccessText Text="Stage" VerticalAlignment="Center" /><views:AppIcon IconName="Stage" /></StackPanel>
              </Button>
              <Border Grid.Column="5" Width="1" Margin="3,2" Background="{DynamicResource SubtleBorderBrush}" />
              <Button x:Name="StageAllBarButton" Grid.Column="6" Classes="tool" MinHeight="22" Padding="4,1" Command="{Binding StageAllCommand}" ToolTip.Tip="Stage all" AutomationProperties.Name="Stage all">
                <views:AppIcon IconName="StageAll" />
              </Button>
            </Grid>
          </Border>
          <Border DockPanel.Dock="Top" Classes="sectionHeader">
            <TextBlock x:Name="StagedHeader" Text="{Binding StagedHeader}" FontWeight="SemiBold" VerticalAlignment="Center" />
          </Border>
          <Panel>
            <TreeView x:Name="StagedTreeView" ItemsSource="{Binding StagedTree}" SelectionMode="Multiple" IsVisible="{Binding ShowTree}"
                      SelectionChanged="OnStagedTreeSelectionChanged" DoubleTapped="OnStagedDoubleTapped" BorderThickness="0"
                      ItemTemplate="{StaticResource ChangeTreeTemplate}" />
            <ListBox x:Name="StagedList" ItemsSource="{Binding Staged}" SelectedItem="{Binding SelectedStaged}" SelectionMode="Multiple" IsVisible="{Binding ShowList}"
                     SelectionChanged="OnStagedSelectionChanged" DoubleTapped="OnStagedDoubleTapped" BorderThickness="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ChangedFileViewModel">
                  <Grid ColumnDefinitions="20,Auto,*" ColumnSpacing="6" ToolTip.Tip="{Binding Description}">
                    <views:AppIcon IconName="{Binding StatusIcon}" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding FileName}" />
                    <TextBlock Grid.Column="2" Text="{Binding Directory}" Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoStagedText" Text="There are no staged changes" Opacity="0.55" Margin="10" IsHitTestVisible="False" IsVisible="{Binding HasNoStaged}" />
          </Panel>
        </DockPanel>
        <Border Grid.Row="3" Padding="6,3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SubtleBorderBrush}" IsVisible="{Binding HasCommitter}">
          <TextBlock x:Name="CommitterText" Text="{Binding CommitterText}" Foreground="{DynamicResource AccentTextForeground}" TextTrimming="CharacterEllipsis" ToolTip.Tip="The identity the commit is made with" />
        </Border>
      </Grid>
      <GridSplitter Grid.Column="1" Width="5" Background="Transparent" VerticalAlignment="Stretch" ResizeDirection="Columns" />
      <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SubtleBorderBrush}">
        <Panel>
          <Border x:Name="DiffHost" IsVisible="{Binding !Resolver.IsActive}">
            <views:DiffView x:Name="DiffPanel" Classes="compact" DataContext="{Binding Diff}" />
          </Border>
          <views:ConflictResolverView x:Name="ConflictPanel" DataContext="{Binding Resolver}" IsVisible="{Binding IsActive}" />
        </Panel>
      </Border>
    </Grid>

    <GridSplitter Grid.Row="4" Height="5" Background="Transparent" HorizontalAlignment="Stretch" ResizeDirection="Rows" />

    <!-- Message and actions -->
    <Border Grid.Row="5" Padding="8,2,8,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SubtleBorderBrush}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,4">
          <TextBlock Text="Commit message" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button x:Name="TemplatesButton" Grid.Column="2" Classes="tool" Click="OnTemplatesClick" Margin="0,0,4,0">
            <StackPanel Orientation="Horizontal" Spacing="4"><views:AppIcon IconName="CommitTemplates" /><AccessText Text="Templates ▾" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button x:Name="RecentButton" Grid.Column="3" Classes="tool" Content="Recent messages ▾" Click="OnRecentClick" IsEnabled="{Binding HasRecentMessages}" />
        </Grid>
        <!-- Like the original: the options sit left of the commit buttons on one line; "Reset all changes" is in the toolbar only. -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
          <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
            <CheckBox x:Name="AmendBox" Content="_Amend commit" IsChecked="{Binding Commit.Amend}" IsEnabled="{Binding Commit.HasHead}" Margin="0,0,12,0" />
            <CheckBox x:Name="ResetAuthorBox" Content="Reset author" IsChecked="{Binding Commit.ResetAuthor}" IsVisible="{Binding Commit.Amend}" Margin="0,0,12,0"
                      ToolTip.Tip="Also overwrite the author and the date of the amended commit" />
            <CheckBox x:Name="ResetSoftBox" Content="Reset soft" IsChecked="{Binding Commit.ResetSoft}" IsVisible="{Binding Commit.Amend}" Margin="0,0,12,0"
                      ToolTip.Tip="Soft reset to the previous commit (index and working tree untouched), then commit the staged changes as a new commit" />
            <CheckBox x:Name="SignOffBox" Content="Sign off" IsChecked="{Binding Commit.SignOff}" Margin="0,0,12,0" />
            <CheckBox x:Name="PushBox" Content="Push after commit" IsChecked="{Binding PushAfterCommit}" Margin="0,0,12,0" />
            <CheckBox x:Name="CloseBox" Content="Close after commit" IsChecked="{Binding CloseAfterCommit}" />
          </WrapPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button x:Name="CommitAndPushButton" Command="{Binding CommitAndPushCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4"><views:AppIcon IconName="ArrowUp" /><AccessText Text="Commit &amp; _push" VerticalAlignment="Center" /></StackPanel>
          </Button>
            <Button x:Name="CommitButton" Classes="accent" Command="{Binding CommitNowCommand}" ToolTip.Tip="Commit (Ctrl+Enter)">
            <StackPanel Orientation="Horizontal" Spacing="4"><views:AppIcon IconName="RepoStateClean" /><AccessText Text="_Commit" VerticalAlignment="Center" /></StackPanel>
          </Button>
          </StackPanel>
        </Grid>
        <TextBlock x:Name="ErrorLabel" DockPanel.Dock="Bottom" Text="{Binding ErrorText}" IsVisible="{Binding HasError}"
                   Foreground="{DynamicResource ErrorTextForeground}" TextWrapping="Wrap" Margin="0,4,0,0" />
        <TextBox x:Name="MessageBox" Text="{Binding Commit.Message}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Height="120"
                 PlaceholderText="Enter commit message" />
      </DockPanel>
    </Border>

    <!-- Status line -->
    <Border Grid.Row="6" Padding="8,3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SubtleBorderBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" Opacity="0.8" />
        <TextBlock Grid.Column="1" Text="Pushing…" IsVisible="{Binding IsPushing}" Opacity="0.8" />
      </Grid>
    </Border>
  </Grid>
</Window>
