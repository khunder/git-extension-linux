<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             xmlns:mgmt="using:GitExtensions.Desktop.Views"
             x:Class="GitExtensions.Desktop.Views.RefsTreeView"
             x:DataType="vm:RefsTreeViewModel">
  <DockPanel Background="{DynamicResource SidebarBackground}">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="6,4" ColumnSpacing="4">
      <TextBlock Text="Search:" VerticalAlignment="Center" />
      <TextBox x:Name="FilterBox" Grid.Column="1" Text="{Binding Filter}" Watermark="Filter…" MinHeight="24" Padding="4,2" />
      <Button x:Name="NewBranchButton" Grid.Column="2" MinHeight="24" Content="+" FontWeight="Bold" Padding="8,2" Command="{Binding RequestNewBranchCommand}" ToolTip.Tip="New branch…" AutomationProperties.Name="New branch" AutomationProperties.HelpText="Create a new branch from the selected commit or HEAD" />
    </Grid>
    <mgmt:RefsPromptView x:Name="RefsPrompt" DockPanel.Dock="Top" />
    <TreeView x:Name="RefsTree" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:RefNodeViewModel">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:RefNodeViewModel">
          <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent">
            <TextBlock Text="{Binding Marker}" Width="10" Foreground="{DynamicResource AccentTextForeground}" VerticalAlignment="Center" />
            <mgmt:AppIcon IconName="{Binding IconName}" />
            <TextBlock Text="{Binding Header}" FontWeight="{Binding FontWeight}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TrackText}" IsVisible="{Binding ShowTrack}" ToolTip.Tip="{Binding TrackToolTip}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentTextForeground}" />
            <TextBlock Text="{Binding TrackText}" IsVisible="{Binding ShowGone}" ToolTip.Tip="{Binding TrackToolTip}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource ErrorTextForeground}" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
