<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             xmlns:mgmt="using:GitExtensions.Desktop.Views"
             x:Class="GitExtensions.Desktop.Views.RefsTreeView"
             x:DataType="vm:RefsTreeViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="6" ColumnSpacing="4">
      <TextBox x:Name="FilterBox" Text="{Binding Filter}" Watermark="Filter branches, tags…" />
      <Button x:Name="NewBranchButton" Grid.Column="1" Content="+" FontWeight="Bold" Padding="8,2" Command="{Binding RequestNewBranchCommand}" ToolTip.Tip="New branch…" AutomationProperties.Name="New branch" AutomationProperties.HelpText="Create a new branch from the selected commit or HEAD" />
    </Grid>
    <mgmt:RefsPromptView x:Name="RefsPrompt" DockPanel.Dock="Top" />
    <TreeView x:Name="RefsTree" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="vm:RefNodeViewModel">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ItemTemplate>
        <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:RefNodeViewModel">
          <StackPanel Orientation="Horizontal" Spacing="4" Background="Transparent">
            <StackPanel.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Checkout"
                          IsEnabled="{Binding CanCheckout}"
                          Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).CheckoutCommand}"
                          CommandParameter="{Binding}" />
                <Separator />
                <MenuItem Header="Merge into current branch" IsEnabled="{Binding CanMergeOrRebase}">
                  <MenuItem Header="Merge (fast-forward when possible)" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).MergeIntoCurrentCommand}" CommandParameter="{Binding}" />
                  <MenuItem Header="Merge, always create a merge commit (--no-ff)" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).MergeNoFastForwardCommand}" CommandParameter="{Binding}" />
                  <MenuItem Header="Merge, fast-forward only (--ff-only)" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).MergeFastForwardOnlyCommand}" CommandParameter="{Binding}" />
                </MenuItem>
                <MenuItem Header="Rebase current branch onto this" IsEnabled="{Binding CanMergeOrRebase}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).RebaseOntoCommand}" CommandParameter="{Binding}" />
                <Separator IsVisible="{Binding !IsRemoteRoot}" />
                <MenuItem Header="Rename…" IsVisible="{Binding IsLocalBranch}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).RequestRenameCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Delete branch" IsVisible="{Binding IsLocalBranch}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).DeleteBranchCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Set upstream…" IsVisible="{Binding IsLocalBranch}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).RequestSetUpstreamCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Unset upstream" IsVisible="{Binding IsLocalBranch}" IsEnabled="{Binding HasUpstream}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).UnsetUpstreamCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Push" IsVisible="{Binding IsLocalBranch}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).PushBranchCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Create branch from here…" IsVisible="{Binding IsLeaf}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).RequestNewBranchCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Create tag here…" IsVisible="{Binding IsTagsGroup}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).RequestNewTagCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Create tag here…" IsVisible="{Binding IsLocalBranch}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).RequestNewTagCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Push all tags…" IsVisible="{Binding IsTagsGroup}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).RequestPushAllTagsCommand}" />
                <MenuItem Header="Checkout as local tracking branch" IsVisible="{Binding IsRemoteBranch}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).CheckoutRemoteAsTrackingCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Delete remote branch…" IsVisible="{Binding IsRemoteBranch}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).RequestDeleteRemoteBranchCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Fetch this remote" IsVisible="{Binding CanFetchRemote}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).FetchRemoteCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Push tag" IsVisible="{Binding IsTag}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).PushTagCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Delete tag…" IsVisible="{Binding IsTag}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).RequestDeleteTagCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="Copy name" IsVisible="{Binding IsLeaf}" Command="{Binding $parent[UserControl].((vm:RefsTreeViewModel)DataContext).CopyNameCommand}" CommandParameter="{Binding}" />
              </ContextMenu>
            </StackPanel.ContextMenu>
            <TextBlock Text="{Binding Marker}" Width="10" Foreground="{DynamicResource SystemAccentColor}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Name}" FontWeight="{Binding FontWeight}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TrackText}" IsVisible="{Binding ShowTrack}" ToolTip.Tip="{Binding TrackToolTip}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource SystemAccentColor}" />
            <TextBlock Text="{Binding TrackText}" IsVisible="{Binding ShowGone}" ToolTip.Tip="{Binding TrackToolTip}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource ErrorTextForeground}" />
          </StackPanel>
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
