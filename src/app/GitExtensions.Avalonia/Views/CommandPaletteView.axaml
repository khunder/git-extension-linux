<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.CommandPaletteView"
             x:DataType="vm:CommandPaletteViewModel"
             IsVisible="{Binding IsOpen}">
  <!-- Scrim over the whole content area; clicking it closes the palette. The card hangs from the top, like a quick-open box. -->
  <Panel x:Name="Scrim" Background="{DynamicResource ScrimBrush}">
    <Border x:Name="Card" MaxWidth="560" MinWidth="280" Margin="16,48,16,16" Padding="8"
            VerticalAlignment="Top" HorizontalAlignment="Center"
            CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource DialogBackground}"
            BorderBrush="{DynamicResource SubtleBorderBrush}"
            KeyboardNavigation.TabNavigation="Cycle"
            AutomationProperties.Name="Command palette"
            AutomationProperties.HelpText="Type to filter commands, Up and Down to choose, Enter to run, Escape to close">
      <DockPanel>
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Text="{Binding Filter}" Watermark="Type a command…" Margin="0,0,0,6"
                 AutomationProperties.Name="Filter commands" />
        <TextBlock x:Name="EmptyText" DockPanel.Dock="Bottom" Text="No matching commands" Opacity="0.65" Margin="8,6"
                   IsVisible="{Binding !Items.Count}" />
        <ListBox x:Name="CommandList" ItemsSource="{Binding Items}" SelectedIndex="{Binding SelectedIndex}" MaxHeight="360"
                 IsVisible="{Binding Items.Count}" Focusable="False" AutomationProperties.Name="Commands">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Focusable" Value="False" />
              <Setter Property="MinHeight" Value="30" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PaletteItem">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Gesture}" Classes="mono" Opacity="0.65" FontSize="12" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
