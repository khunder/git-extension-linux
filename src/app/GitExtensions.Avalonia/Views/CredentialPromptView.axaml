<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.CredentialPromptView"
             x:DataType="vm:CredentialPromptViewModel"
             IsVisible="{Binding IsOpen}">
  <!-- Scrim over the content area; the card is centered. Shown while git or ssh waits for a credential. -->
  <Panel Background="#80000000">
    <Border x:Name="Card" MaxWidth="460" Margin="24" Padding="20" VerticalAlignment="Center" HorizontalAlignment="Center"
            CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}">
      <StackPanel Spacing="10" MinWidth="360">
        <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="PromptTextBlock" Text="{Binding PromptText}" TextWrapping="Wrap" />
        <TextBox x:Name="InputBox" Text="{Binding InputText}" PasswordChar="{Binding PasswordChar}" IsVisible="{Binding ShowTextInput}" Watermark="Type your answer">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
            <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <CheckBox x:Name="RememberBox" Content="Remember for this session" IsChecked="{Binding RememberForSession}" IsVisible="{Binding ShowRemember}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
          <Button x:Name="CancelButton" Content="Cancel" Command="{Binding CancelCommand}" />
          <Button x:Name="OkButton" Content="{Binding ConfirmText}" Classes="accent" Command="{Binding ConfirmCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>
</UserControl>
