<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitExtensions.Desktop.ViewModels"
             x:Class="GitExtensions.Desktop.Views.CredentialPromptView"
             x:DataType="vm:CredentialPromptViewModel">
  <!-- Content of the small credential dialog; shown while git or ssh waits for a credential. -->
  <DockPanel x:Name="Card" Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button x:Name="OkButton" Content="{Binding ConfirmText}" Classes="accent" IsDefault="True" MinWidth="80" HorizontalContentAlignment="Center" Command="{Binding ConfirmCommand}" />
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" HorizontalContentAlignment="Center" Command="{Binding CancelCommand}" />
    </StackPanel>
    <StackPanel Spacing="8">
      <TextBlock x:Name="TitleText" Text="{Binding Title}" FontWeight="SemiBold" />
      <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="PromptTextBlock" Text="{Binding PromptText}" TextWrapping="Wrap" />
      </ScrollViewer>
      <TextBox x:Name="InputBox" Text="{Binding InputText}" PasswordChar="{Binding PasswordChar}" IsVisible="{Binding ShowTextInput}" PlaceholderText="Type your answer">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
          <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <CheckBox x:Name="RememberBox" Content="Remember for this session" IsChecked="{Binding RememberForSession}" IsVisible="{Binding ShowRemember}" />
    </StackPanel>
  </DockPanel>
</UserControl>
